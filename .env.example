# Copy this file to .env and replace the placeholder application key.
ACOUSTID_API_KEY=replace-with-your-application-key

# Optional Discogs filename validation. Create a personal token at:
# https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional unofficial Shazam last fallback. No API key is required. Disabled
# by default because the reverse-engineered service can change without notice.
CREATE_METADATA_SHAZAM=false

# Optional create_metadata settings.
CREATE_METADATA_FPCALC=fpcalc
CREATE_METADATA_FFMPEG=ffmpeg
CREATE_METADATA_MIN_SCORE=0.90
CREATE_METADATA_MIN_MARGIN=0.05
CREATE_METADATA_TIMEOUT=120
CREATE_METADATA_NETWORK_TIMEOUT=30
CREATE_METADATA_CACHE=true
# Provider responses expire after this many days; fingerprints are invalidated
# automatically whenever the source path, size, or modification time changes.
CREATE_METADATA_CACHE_TTL_DAYS=30
# Optional override. macOS defaults to ~/Library/Caches/create-metadata/cache.sqlite3
# CREATE_METADATA_CACHE_FILE=/path/to/cache.sqlite3
