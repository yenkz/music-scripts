				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	set musicDupesPath to (POSIX path of (path to home folder)) &amp; ".local/bin/music-dupes"

	repeat with selectedFolder in input
		set selectedPath to POSIX path of selectedFolder
		set shellCommand to "/bin/zsh " &amp; (quoted form of musicDupesPath) &amp; " --menu " &amp; (quoted form of selectedPath)

		tell application "Terminal"
			activate
			set reviewTab to do script ""
			delay 1
			repeat while (busy of reviewTab)
				delay 0.1
			end repeat
			do script shellCommand in reviewTab
		end tell
	end repeat

	return input
end run</string>
				</dict>
